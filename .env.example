# --- Database ---
# In Docker Compose this points at the postgres service.
# Locally, leave unset to fall back to a SQLite file (./arc_engine.db).
DATABASE_URL=postgresql://arc:arc@postgres:5432/arc

# --- Redis / async worker queue ---
REDIS_URL=redis://redis:6379/0

# --- ARC data ---
ARC_DATA_ROOT=data/raw/ARC-AGI-2

# --- Model registry / checkpoints ---
MODEL_REGISTRY_PATH=artifacts/model_registry.json
CHECKPOINT_DIR=checkpoints

# --- Serving limits ---
MAX_RECURSION_STEPS=64
DEFAULT_MODEL_ID=trm_arc_v1

# --- Inference device: auto | cpu | cuda | mps ---
ARC_DEVICE=auto

# --- Web -> API base URL (used by Next.js server + client) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080
